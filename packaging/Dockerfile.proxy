# lsec read-only Docker API proxy
#
# A deliberately tiny image. It receives the Docker socket and exposes only an
# allowlisted GET API to lsec over an internal-only network.
FROM python:3.15-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LSEC_DOCKER_SOCKET=/var/run/docker.sock

COPY packaging/docker_proxy.py /usr/local/bin/lsec-docker-proxy

RUN chmod 0755 /usr/local/bin/lsec-docker-proxy

EXPOSE 2375

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:2375/__health', timeout=3)"]

ENTRYPOINT ["python3", "/usr/local/bin/lsec-docker-proxy"]
