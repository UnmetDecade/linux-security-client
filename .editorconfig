root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are intentional Markdown hard line breaks in the docs.
trim_trailing_whitespace = false

[*.{sh,service,toml}]
indent_size = 4
